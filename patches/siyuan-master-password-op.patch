+// resolveMasterPassword 在解锁路径上按需从 1Password 读取主密码。
+// 用户显式输入非空密码时以用户输入为准；仅在空密码时尝试 op read，
+// 此时 1Password 桌面端会弹出授权确认，用户点允许后返回读取到的密码。
+// op 不可用或读取失败时回落到用户输入（空密码则交给后续 Argon2id 校验报错，弹出普通密码对话框）。
+func resolveMasterPassword(password string) string {
+	if "" != password {
+		return password
+	}
+	opURI := os.Getenv("SIYUAN_MASTER_PASSWORD_OP")
+	if "" == opURI {
+		return password
+	}
+	value, err := exec.Command("op", "read", opURI).Output()
+	if nil != err {
+		logging.LogWarnf("op read master password failed, falling back to manual input: %s", err)
+		return password
+	}
+	return strings.TrimSpace(string(value))
+}
