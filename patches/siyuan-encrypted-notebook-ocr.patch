+// along with this program.  If not, see <https://www.gnu.org/licenses/>.
+
+package model
+
+import (
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+
+	"github.com/88250/gulu"
+	"github.com/siyuan-note/filelock"
+	"github.com/siyuan-note/logging"
+	"github.com/siyuan-note/siyuan/kernel/treenode"
+	"github.com/siyuan-note/siyuan/kernel/util"
+)
+
+// 加密笔记本的 OCR 文本 store：
+//   - 落盘位置 <DataDir>/<boxID>/.siyuan/ocr-texts，内容用 DEK 派生子密钥加密（默认不含明文，见设计文档 §20）；
+//   - 解锁时加载进内存（util/ocr_box.go），锁定/卸载时先落盘再丢弃内存副本；
+//   - 内存/落盘均按 box 隔离，不进入全局 data/assets/ocr-texts.json，避免把密文笔记本内容写入明文索引。
+
+const boxOCRTextKeyPurpose = "siyuan/ocr-texts"
+
+func boxOCRAAD(boxID string) []byte {
+	return []byte("siyuan:ocr-texts:" + boxID)
+}
+
+func encryptBoxOCRTexts(boxID string, dek, plaintext []byte) ([]byte, error) {
+	key := util.DeriveSubKey(dek, boxOCRTextKeyPurpose)
+	defer zeroAndClear(key)
+	return util.EncryptWithAAD(key, plaintext, boxOCRAAD(boxID))
+}
+
+func decryptBoxOCRTexts(boxID string, dek, ciphertext []byte) ([]byte, error) {
+	key := util.DeriveSubKey(dek, boxOCRTextKeyPurpose)
+	defer zeroAndClear(key)
+	return util.DecryptWithAAD(key, ciphertext, boxOCRAAD(boxID))
+}
+
+func boxOCRTextsPath(boxID string) string {
+	return util.BoxAssetsTextsFilePath(boxID)
+}
+
+func loadBoxOCRTexts(boxID string, dek []byte) error {
+	p := boxOCRTextsPath(boxID)
+	if !filelock.IsExist(p) {
+		return nil
+	}
+	data, err := filelock.ReadFile(p)
+	if err != nil {
+		return err
+	}
+	plain, err := decryptBoxOCRTexts(boxID, dek, data)
+	if err != nil {
+		logging.LogErrorf("decrypt box OCR texts [%s] failed: %s", boxID, err)
+		return err
+	}
+	texts := map[string]string{}
+	if err = gulu.JSON.UnmarshalJSON(plain, &texts); err != nil {
+		logging.LogErrorf("unmarshal box OCR texts [%s] failed: %s", boxID, err)
+		return err
+	}
+	util.LoadBoxAssetsTexts(boxID, texts)
+	return nil
+}
+
+func saveBoxOCRTexts(boxID string) error {
+	texts, changed := util.DumpBoxAssetsTexts(boxID)
+	if !changed {
+		return nil
+	}
+	dek, ok := cachedDEKCopy(boxID)
+	if !ok {
+		return errors.New("encrypted notebook is locked, please unlock it first")
+	}
+	defer zeroAndClear(dek)
+	data, err := gulu.JSON.MarshalIndentJSON(texts, "", "  ")
+	if err != nil {
+		return err
+	}
+	ciphertext, err := encryptBoxOCRTexts(boxID, dek, data)
+	if err != nil {
+		return err
+	}
+	if err = os.MkdirAll(util.BoxAssetsTextsDir(boxID), 0755); err != nil {
+		return err
+	}
+	if err = filelock.WriteFile(boxOCRTextsPath(boxID), ciphertext); err != nil {
+		return err
+	}
+	util.ResetBoxAssetsTextsDirty(boxID)
+	return nil
+}
+
+func saveAllBoxesOCRTexts() {
+	for _, boxID := range treenode.GetOpenedEncryptedBoxIDs() {
+		if !isBoxUnlockedForAccess(boxID) {
+			continue
+		}
+		if err := saveBoxOCRTexts(boxID); err != nil {
+			logging.LogWarnf("save box OCR texts [%s] failed: %s", boxID, err)
+		}
+	}
+}
+
+// getUnOCRBoxAssets 返回所有已解锁加密笔记本中尚未 OCR 的图片资源。
+// key 为不含查询参数的 "assets/..." 相对路径；返回前清理已不存在资源的文本记录。
+func getUnOCRBoxAssets() map[string][]string {
+	ret := map[string][]string{}
+	for _, boxID := range treenode.GetOpenedEncryptedBoxIDs() {
+		if !isBoxUnlockedForAccess(boxID) {
+			continue
+		}
+		assetsDir := filepath.Join(util.DataDir, boxID, "assets")
+		if !filelock.IsExist(assetsDir) {
+			continue
+		}
+		util.CleanNotExistBoxAssetsTexts(boxID)
+		var relPaths []string
+		_ = filelock.Walk(assetsDir, func(path string, d fs.DirEntry, err error) error {
+			if nil != err || nil == d {
+				return err
+			}
+			if d.IsDir() {
+				if strings.HasPrefix(d.Name(), ".") {
+					return filepath.SkipDir
+				}
+				return nil
+			}
+			if strings.HasPrefix(d.Name(), ".") || filelock.IsHidden(path) || util.IsOfficeTempFile(path) {
+				return nil
+			}
+			rel := filepath.ToSlash(filepath.Join("assets", strings.TrimPrefix(path, assetsDir)))
+			if !util.IsTesseractExtractable(rel) {
+				return nil
+			}
+			if util.ExistsBoxAssetText(boxID, rel) {
+				return nil
+			}
+			relPaths = append(relPaths, rel)
+			return nil
+		})
+		if 0 < len(relPaths) {
+			ret[boxID] = relPaths
+		}
+	}
+	return ret
+}
+
+// ocrBoxAssetFile 解密 box 内图片到临时文件后交给 tesseract（tesseract 需要文件路径），
+// 返回 TSV 结果，临时明文文件随即删除。
+func ocrBoxAssetFile(boxID, relPath string) (ret []map[string]any, err error) {
+	plain, err := ReadAssetBytesInBox(boxID, relPath)
+	if err != nil {
+		return nil, err
+	}
+	defer clear(plain)
+	tmpDir := filepath.Join(util.TempDir, "ocr")
+	if err = os.MkdirAll(tmpDir, 0700); err != nil {
+		return nil, err
+	}
+	tmpPath := filepath.Join(tmpDir, fmt.Sprintf("%s-%s%s", boxID, gulu.Rand.String(12), filepath.Ext(relPath)))
+	if err = os.WriteFile(tmpPath, plain, 0600); err != nil {
+		return nil, err
+	}
+	defer func() {
+		if rmErr := os.Remove(tmpPath); rmErr != nil {
+			logging.LogWarnf("remove temp OCR file [%s] failed: %s", tmpPath, rmErr)
+		}
+	}()
+	return util.Tesseract(tmpPath), nil
+}
+
+// OcrAssetInBox 对加密笔记本内的图片执行 OCR（供 API /api/asset/ocr 手动触发）。
+func OcrAssetInBox(boxID, assetPath string) (ret []map[string]any, err error) {
+	if !util.TesseractEnabled {
+		return nil, errors.New(Conf.Language(266))
+	}
+	if "" == boxID || !IsEncryptedBox(boxID) {
+		return nil, errors.New("not an encrypted notebook asset")
+	}
+	if !isBoxUnlockedForAccess(boxID) {
+		return nil, errors.New("Encrypted notebook is locked, please unlock it first")
+	}
+	relPath := AssetPathWithoutQuery(assetPath)
+	ret, err = ocrBoxAssetFile(boxID, relPath)
+	if err != nil {
+		return nil, err
+	}
+	text := util.GetOcrJsonText(ret)
+	util.SetBoxAssetText(boxID, relPath, text)
+	if "" != text {
+		if err = saveBoxOCRTexts(boxID); err != nil {
+			logging.LogWarnf("save box OCR texts [%s] failed: %s", boxID, err)
+		}
+	}
+	return
+}
+
+// ocrBoxAssets 对给定加密笔记本的图片执行 OCR，返回处理数量；budget 为该任务本轮剩余上限。
+func ocrBoxAssets(boxID string, relPaths []string, budget int) (processed int) {
+	if !util.TesseractEnabled || "" == boxID || !isBoxUnlockedForAccess(boxID) {
+		return 0
+	}
+	for _, relPath := range relPaths {
+		if budget <= processed {
+			break
+		}
+		tsv, err := ocrBoxAssetFile(boxID, relPath)
+		if err != nil {
+			logging.LogWarnf("ocr box asset [%s] failed: %s", relPath, err)
+			continue
+		}
+		util.SetBoxAssetText(boxID, relPath, util.GetOcrJsonText(tsv))
+		processed++
+	}
+	return processed
+}
+
+// sortedBoxIDs 输出稳定的 boxID 顺序，保证自动 OCR 任务的可重复性。
+func sortedBoxIDs(boxAssets map[string][]string) (ret []string) {
+	for boxID := range boxAssets {
+		ret = append(ret, boxID)
+	}
+	sort.Strings(ret)
+	return
+}
