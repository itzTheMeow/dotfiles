+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU Affero General Public License for more details.
+//
+// You should have received a copy of the GNU Affero General Public License
+// along with this program.  If not, see <https://www.gnu.org/licenses/>.
+
+package util
+
+import (
+	"path/filepath"
+	"strings"
+	"sync"
+	"sync/atomic"
+
+	"github.com/88250/lute/ast"
+	"github.com/siyuan-note/filelock"
+)
+
+// 加密笔记本的 OCR 文本按 box 隔离存储：
+//   - 内存中每个已解锁 box 一张 map，key 为不含查询参数的 "assets/..." 路径（与普通 notebook 一致）；
+//   - 索引（sql/block.go）与 API 使用带 ?box= 参数的完整 key，由 SetAssetText/GetAssetText/ExistsAssetText
+//     统一路由到对应的 box 存储，普通 notebook 的行为保持不变；
+//   - 持久化由 model 层负责（加密落盘 + 解锁加载 + 锁定丢弃，见 model/ocr_box.go），
+//     util 仅维护内存状态与变更标记，不接触明文文件。
+var (
+	boxAssetsTexts        = map[string]map[string]string{}
+	boxAssetsTextsLock    = sync.Mutex{}
+	boxAssetsTextsChanged = map[string]*atomic.Bool{}
+)
+
+func BoxAssetsTextsDir(boxID string) string {
+	return filepath.Join(DataDir, boxID, ".siyuan")
+}
+
+func BoxAssetsTextsFilePath(boxID string) string {
+	return filepath.Join(BoxAssetsTextsDir(boxID), "ocr-texts")
+}
+
+// BoxIDFromAssetKey 解析 asset key 中的 ?box= 参数；无参数或非法 ID 返回空串。
+func BoxIDFromAssetKey(asset string) string {
+	if idx := strings.Index(asset, "?"); 0 <= idx {
+		for _, pair := range strings.Split(asset[idx+1:], "&") {
+			if strings.HasPrefix(pair, "box=") {
+				boxID := strings.TrimSpace(strings.TrimPrefix(pair, "box="))
+				if ast.IsNodeIDPattern(boxID) {
+					return boxID
+				}
+				return ""
+			}
+		}
+	}
+	return ""
+}
+
+// IsEncryptedBoxAssetKey 判断 asset key 是否指向加密笔记本内的资源。
+func IsEncryptedBoxAssetKey(asset string) bool {
+	return "" != BoxIDFromAssetKey(asset)
+}
+
+// normalizeBoxAssetKey 去掉查询参数得到 "assets/..." 形式，作为 box 内存储的实际 key。
+func normalizeBoxAssetKey(asset string) string {
+	if idx := strings.Index(asset, "?"); 0 <= idx {
+		asset = asset[:idx]
+	}
+	return filepath.ToSlash(asset)
+}
+
+func boxAssetsTextsMap(boxID string) map[string]string {
+	texts, ok := boxAssetsTexts[boxID]
+	if !ok {
+		texts = map[string]string{}
+		boxAssetsTexts[boxID] = texts
+	}
+	return texts
+}
+
+func boxAssetsTextsDirty(boxID string) *atomic.Bool {
+	dirty, ok := boxAssetsTextsChanged[boxID]
+	if !ok {
+		dirty = &atomic.Bool{}
+		boxAssetsTextsChanged[boxID] = dirty
+	}
+	return dirty
+}
+
+// SetBoxAssetText 记录加密笔记本内资源的 OCR 文本。boxID 为空或资源路径非法时忽略。
+func SetBoxAssetText(boxID, asset, text string) {
+	if "" == boxID {
+		return
+	}
+	key := normalizeBoxAssetKey(asset)
+	if !strings.HasPrefix(key, "assets/") {
+		return
+	}
+	boxAssetsTextsLock.Lock()
+	texts := boxAssetsTextsMap(boxID)
+	oldText, ok := texts[key]
+	texts[key] = text
+	boxAssetsTextsLock.Unlock()
+	if !ok || oldText != text {
+		boxAssetsTextsDirty(boxID).Store(true)
+	}
+}
+
+// GetBoxAssetText 读取加密笔记本内资源的 OCR 文本；box 未解锁（未加载）时返回空串。
+func GetBoxAssetText(boxID, asset string) (ret string) {
+	if "" == boxID {
+		return
+	}
+	key := normalizeBoxAssetKey(asset)
+	boxAssetsTextsLock.Lock()
+	if texts, ok := boxAssetsTexts[boxID]; ok {
+		ret = texts[key]
+	}
+	boxAssetsTextsLock.Unlock()
+	return
+}
+
+// ExistsBoxAssetText 判断加密笔记本内资源是否已有 OCR 文本记录。
+func ExistsBoxAssetText(boxID, asset string) bool {
+	if "" == boxID {
+		return false
+	}
+	key := normalizeBoxAssetKey(asset)
+	boxAssetsTextsLock.Lock()
+	_, ok := boxAssetsTexts[boxID][key]
+	boxAssetsTextsLock.Unlock()
+	return ok
+}
+
+// RemoveBoxAssetText 删除加密笔记本内资源的 OCR 文本记录。
+func RemoveBoxAssetText(boxID, asset string) {
+	if "" == boxID {
+		return
+	}
+	key := normalizeBoxAssetKey(asset)
+	boxAssetsTextsLock.Lock()
+	if texts, ok := boxAssetsTexts[boxID]; ok {
+		if _, existed := texts[key]; existed {
+			delete(texts, key)
+			boxAssetsTextsChanged[boxID].Store(true)
+		}
+	}
+	boxAssetsTextsLock.Unlock()
+}
+
+// BoxAssetFilePath 返回加密笔记本资源文件的绝对路径（不释放密文）。
+func BoxAssetFilePath(boxID, asset string) string {
+	key := normalizeBoxAssetKey(asset)
+	key = strings.TrimPrefix(key, "assets/")
+	return filepath.Join(DataDir, boxID, "assets", key)
+}
+
+// ExistsBoxAssetFile 判断加密笔记本资源文件是否存在于磁盘。
+func ExistsBoxAssetFile(boxID, asset string) bool {
+	if "" == boxID {
+		return false
+	}
+	return filelock.IsExist(BoxAssetFilePath(boxID, asset))
+}
+
+// CleanNotExistBoxAssetsTexts 清理已不存在资源对应的 OCR 文本记录。
+func CleanNotExistBoxAssetsTexts(boxID string) {
+	boxAssetsTextsLock.Lock()
+	texts, ok := boxAssetsTexts[boxID]
+	if !ok {
+		boxAssetsTextsLock.Unlock()
+		return
+	}
+	var toRemoves []string
+	for asset := range texts {
+		if filelock.IsExist(BoxAssetFilePath(boxID, "assets/"+strings.TrimPrefix(asset, "assets/"))) {
+			continue
+		}
+		toRemoves = append(toRemoves, asset)
+	}
+	for _, asset := range toRemoves {
+		delete(texts, asset)
+	}
+	dirty := boxAssetsTextsChanged[boxID]
+	boxAssetsTextsLock.Unlock()
+	if 0 < len(toRemoves) {
+		dirty.Store(true)
+	}
+}
+
+// ClearBoxAssetsTexts 丢弃指定 box 的内存 OCR 文本（锁定/卸载时调用，防止明文残留在内存）。
+func ClearBoxAssetsTexts(boxID string) {
+	boxAssetsTextsLock.Lock()
+	delete(boxAssetsTexts, boxID)
+	delete(boxAssetsTextsChanged, boxID)
+	boxAssetsTextsLock.Unlock()
+}
+
+// LoadBoxAssetsTexts 载入指定 box 的 OCR 文本（解锁时调用）。texts 可能为 nil。
+func LoadBoxAssetsTexts(boxID string, texts map[string]string) {
+	boxAssetsTextsLock.Lock()
+	boxAssetsTexts[boxID] = texts
+	dirty := boxAssetsTextsDirty(boxID)
+	boxAssetsTextsLock.Unlock()
+	dirty.Store(false)
+}
+
+// DumpBoxAssetsTexts 返回指定 box 的 OCR 文本副本及是否有未持久化的变更。
+func DumpBoxAssetsTexts(boxID string) (texts map[string]string, changed bool) {
+	boxAssetsTextsLock.Lock()
+	texts = map[string]string{}
+	if src, ok := boxAssetsTexts[boxID]; ok {
+		for k, v := range src {
+			texts[k] = v
+		}
+	}
+	if dirty := boxAssetsTextsChanged[boxID]; nil != dirty {
+		changed = dirty.Load()
+	}
+	boxAssetsTextsLock.Unlock()
+	return
+}
+
+// ResetBoxAssetsTextsDirty 在成功持久化后清除变更标记。
+func ResetBoxAssetsTextsDirty(boxID string) {
+	boxAssetsTextsLock.Lock()
+	dirty := boxAssetsTextsChanged[boxID]
+	boxAssetsTextsLock.Unlock()
+	if nil != dirty {
+		dirty.Store(false)
+	}
+}
+
+// BoxAssetsTextsDirty 判断指定 box 是否有未持久化的 OCR 文本变更。
+func BoxAssetsTextsDirty(boxID string) bool {
+	boxAssetsTextsLock.Lock()
+	dirty := boxAssetsTextsChanged[boxID]
+	boxAssetsTextsLock.Unlock()
+	return nil != dirty && dirty.Load()
+}
