+func TestBoxOCRTextsRoutingAndPersistence(t *testing.T) {
+	tmpDir := t.TempDir()
+	boxID := "20260812000001-abcdefg"
+	utilDataDir := DataDir
+	DataDir = tmpDir
+	defer func() { DataDir = utilDataDir }()
+
+	boxDir := filepath.Join(DataDir, boxID)
+	if err := os.MkdirAll(boxDir, 0755); err != nil {
+		t.Fatal(err)
+	}
+	assetFile := filepath.Join(boxDir, "assets", "scan.png")
+	if err := os.MkdirAll(filepath.Dir(assetFile), 0755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(assetFile, []byte("image-bytes"), 0600); err != nil {
+		t.Fatal(err)
+	}
+
+	key := "assets/scan.png?box=" + boxID
+	SetAssetText(key, "hello world")
+
+	if !ExistsBoxAssetText(boxID, "assets/scan.png") {
+		t.Error("box text not recorded")
+	}
+	if !ExistsBoxAssetText(boxID, key) {
+		t.Error("box text not found via query key")
+	}
+	if !ExistsAssetText(key) {
+		t.Error("ExistsAssetText not routed to box store")
+	}
+	if got := GetAssetText(key); got != "hello world" {
+		t.Errorf("GetAssetText(key) = %q, want hello world", got)
+	}
+	if !ExistsBoxAssetFile(boxID, "assets/scan.png") {
+		t.Error("box asset file not detected")
+	}
+	if ExistsAssetText("assets/missing.png?box=" + boxID) {
+		t.Error("missing box text handled wrongly")
+	}
+
+	// 锁定前导出（模拟 saveBoxOCRTexts 之前的 Dump）
+	texts, changed := DumpBoxAssetsTexts(boxID)
+	if !changed || texts["assets/scan.png"] != "hello world" {
+		t.Errorf("DumpBoxAssetsTexts = %v changed=%v", texts, changed)
+	}
+
+	ClearBoxAssetsTexts(boxID)
+	if ExistsAssetText(key) {
+		t.Error("box text not cleared on lock")
+	}
+
+	LoadBoxAssetsTexts(boxID, texts)
+	if got := GetAssetText(key); got != "hello world" {
+		t.Errorf("reload GetAssetText(key) = %q, want hello world", got)
+	}
+	RemoveAssetText(key)
+	if ExistsAssetText(key) {
+		t.Error("box text not removed")
+	}
+
+	// 普通资产行为保持不变
+	SetAssetText("assets/global.png", "g")
+	if GetAssetText("assets/global.png") != "g" {
+		t.Error("global text routing broken")
+	}
+	ClearBoxAssetsTexts(boxID)
+}
