+package model
+
+import (
+	"bytes"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/siyuan-note/siyuan/kernel/util"
+)
+
+const testBoxOCRBoxID = "20260812000002-ocrbox1"
+
+// TestBoxOCRTextsEncryptedRoundTrip 验证 box OCR 文本加密落盘、加载回内存，且落盘文件不含明文 JSON。
+func TestBoxOCRTextsEncryptedRoundTrip(t *testing.T) {
+	tmpDir := t.TempDir()
+	origDataDir, origTempDir := util.DataDir, util.TempDir
+	util.DataDir = tmpDir
+	util.TempDir = filepath.Join(tmpDir, "temp")
+	if err := os.MkdirAll(util.TempDir, 0755); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		util.DataDir, util.TempDir = origDataDir, origTempDir
+	})
+
+	// 模拟运行中的加密笔记本：box conf 标记加密 + DEK 缓存。
+	boxDir := filepath.Join(util.DataDir, testBoxOCRBoxID)
+	if err := os.MkdirAll(filepath.Join(boxDir, ".siyuan"), 0755); err != nil {
+		t.Fatal(err)
+	}
+	dek := make([]byte, 32)
+	for i := range dek {
+		dek[i] = byte(i)
+	}
+	setTestDEK(t, testBoxOCRBoxID, dek)
+	t.Cleanup(func() {
+		cachedDEKsLock.Lock()
+		delete(cachedDEKs, testBoxOCRBoxID)
+		cachedDEKsLock.Unlock()
+	})
+
+	key := "assets/scan.png?box=" + testBoxOCRBoxID
+	util.SetAssetText(key, "the quick brown fox")
+
+	if err := saveBoxOCRTexts(testBoxOCRBoxID); err != nil {
+		t.Fatalf("saveBoxOCRTexts: %v", err)
+	}
+	if util.BoxAssetsTextsDirty(testBoxOCRBoxID) {
+		t.Error("dirty flag not cleared after save")
+	}
+
+	p := boxOCRTextsPath(testBoxOCRBoxID)
+	raw, err := os.ReadFile(p)
+	if err != nil {
+		t.Fatalf("read ocr-texts: %v", err)
+	}
+	if bytes.Contains(raw, []byte("the quick brown fox")) {
+		t.Fatal("plaintext OCR text leaked to disk")
+	}
+	if bytes.Contains(raw, []byte("\"assets/scan.png\"")) {
+		t.Fatal("plaintext key leaked to disk")
+	}
+
+	// 锁定：清内存
+	util.ClearBoxAssetsTexts(testBoxOCRBoxID)
+	util.ResetBoxAssetsTextsDirty(testBoxOCRBoxID)
+	if "" != util.GetAssetText(key) {
+		t.Fatal("box OCR text not dropped on lock")
+	}
+
+	// 解锁：从加密文件恢复
+	if err = loadBoxOCRTexts(testBoxOCRBoxID, dek); err != nil {
+		t.Fatalf("loadBoxOCRTexts: %v", err)
+	}
+	if got := util.GetAssetText(key); got != "the quick brown fox" {
+		t.Fatalf("reloaded getAsset = %q, want the quick brown fox", got)
+	}
+}
+
+// TestBoxOCRTextsTamperRejected 验证篡改密文后无法解密出可用的 OCR 文本。
+func TestBoxOCRTextsTamperRejected(t *testing.T) {
+	tmpDir := t.TempDir()
+	origDataDir := util.DataDir
+	util.DataDir = tmpDir
+	t.Cleanup(func() { util.DataDir = origDataDir })
+
+	boxDir := filepath.Join(util.DataDir, testBoxOCRBoxID)
+	if err := os.MkdirAll(filepath.Join(boxDir, ".siyuan"), 0755); err != nil {
+		t.Fatal(err)
+	}
+	dek := bytes.Repeat([]byte{0x42}, 32)
+	if err := os.WriteFile(boxOCRTextsPath(testBoxOCRBoxID), bytes.Repeat([]byte{0x00}, 128), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := loadBoxOCRTexts(testBoxOCRBoxID, dek); err == nil {
+		t.Fatal("tampered box OCR texts must not load")
+	}
+}
+
+// setTestDEK 直接把明文 DEK 塞进缓存，模拟已解锁状态。
+func setTestDEK(t *testing.T, boxID string, dek []byte) {
+	cachedDEKsLock.Lock()
+	cachedDEKs[boxID] = append([]byte(nil), dek...)
+	cachedDEKsLock.Unlock()
+}
