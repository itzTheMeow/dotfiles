+
+//go:build sqlcipher || libsqlcipher
+
+package model
+
+import (
+	"bytes"
+	"context"
+	"encoding/base64"
+	"errors"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"slices"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/88250/lute/ast"
+	"github.com/siyuan-note/siyuan/kernel/conf"
+	"github.com/siyuan-note/siyuan/kernel/filesys"
+	"github.com/siyuan-note/siyuan/kernel/sql"
+	"github.com/siyuan-note/siyuan/kernel/treenode"
+	"github.com/siyuan-note/siyuan/kernel/util"
+)
+
+const boxOCRTextsE2ETestEnv = "SIYUAN_TEST_BOX_OCR_TEXTS_E2E"
+
+// TestBoxOCRTextsEndToEnd covers the whole encrypted-notebook OCR pipeline against the
+// real kernel primitives:
+//   - an asset is written into the encrypted box (ciphertext at rest),
+//   - a document referencing it is indexed BEFORE OCR: the referencing container is queued
+//     for a deferred OCR reindex and the keyword is not yet searchable,
+//   - tesseract runs on a decrypted temp file and its text lands in the per-box store,
+//   - draining the OCR queue reindexes the block, and the keyword is now findable by the
+//     encrypted-notebook in-box full-text search (never by the global search index),
+//   - the persisted sidecar does not contain the OCR text or the boxID as plaintext,
+//   - on lock the in-memory copy is dropped, on unlock it is restored from the sidecar,
+//   - a tampered sidecar is rejected instead of being loaded.
+//
+// 该测试会改写进程内全局工作区路径（util.DataDir 等），通过子进程执行避免污染同进程其他测试，
+// 与 kernel/model/crypto_create_sqlcipher_test.go 的隔离模式一致。
+func TestBoxOCRTextsEndToEnd(t *testing.T) {
+	if os.Getenv(boxOCRTextsE2ETestEnv) == "1" {
+		testBoxOCRTextsEndToEnd(t)
+		return
+	}
+
+	ctx, cancel := context.WithTimeout(context.Background(), 60*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, os.Args[0], "-test.run=^TestBoxOCRTextsEndToEnd$")
+	cmd.Env = append(os.Environ(), boxOCRTextsE2ETestEnv+"=1")
+	output, err := cmd.CombinedOutput()
+	if errors.Is(ctx.Err(), context.DeadlineExceeded) {
+		t.Fatalf("encrypted-notebook OCR E2E timed out:\n%s", output)
+	}
+	if err != nil {
+		t.Fatalf("encrypted-notebook OCR E2E failed: %v\n%s", err, output)
+	}
+}
+
+func testBoxOCRTextsEndToEnd(t *testing.T) {
+	setupCryptoModelDirs(t)
+
+	Conf = NewAppConf()
+	Conf.FileTree = conf.NewFileTree()
+	*Conf.FileTree.BoxDocEnabled = true
+	Conf.NotebookCrypto = conf.NewNotebookCrypto()
+	Conf.Sync = conf.NewSync()
+	Conf.Search = conf.NewSearch()
+	sql.InitDatabase(true)
+	sql.InitHistoryDatabase(true)
+	sql.InitAssetContentDatabase(true)
+	t.Cleanup(sql.CloseDatabase)
+
+	password := "ocr-box-e2e-test"
+	if err := EnableEncryptedNotebook(password); err != nil {
+		t.Fatalf("enable encrypted notebooks failed: %v", err)
+	}
+	boxID, err := CreateEncryptedBox("OCR Enc", password)
+	if err != nil {
+		t.Fatalf("create encrypted notebook failed: %v", err)
+	}
+
+	util.Container = util.ContainerStd
+	util.InitTesseract()
+	if !util.TesseractEnabled {
+		t.Skip("tesseract-ocr not available in the test environment")
+	}
+	util.WaitForTesseractInit()
+
+	// 1. 往加密笔记本写入一张密文图片（内容为 "Hello OCR"）
+	raw, err := base64.StdEncoding.DecodeString(testOCRFixtureHelloOCR)
+	if err != nil {
+		t.Fatalf("decode OCR fixture failed: %v", err)
+	}
+	blockID := ast.NewNodeID()
+	fName := encryptedAssetName(".png", blockID)
+	assetAbsPath := filepath.Join(util.DataDir, boxID, "assets", fName)
+	if err := os.MkdirAll(filepath.Dir(assetAbsPath), 0755); err != nil {
+		t.Fatal(err)
+	}
+	if err := writeAssetFile(assetAbsPath, bytes.NewReader(raw), boxID, "ocr-sample.png"); err != nil {
+		t.Fatalf("write encrypted asset failed: %v", err)
+	}
+	onDisk, err := os.ReadFile(assetAbsPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !IsEncryptedNotebookData(onDisk) {
+		t.Fatal("encrypted asset was stored as plaintext")
+	}
+
+	relPath := "assets/" + fName
+	key := relPath + "?box=" + boxID
+	if dump := os.Getenv("SIYUAN_DEBUG_DUMP"); dump != "" {
+		_ = os.WriteFile(filepath.Join(dump, "decrypted-from-box.png"), raw, 0644)
+	}
+
+	// 2. 先建立引用该图片的文档并写入索引（此时资源尚未 OCR，容器节点应被挂入 NodeOCRQueue 待重索引）
+	docID := ast.NewNodeID()
+	docPath := "/" + docID + ".sy"
+	docTree := treenode.NewTree(boxID, docPath, "/OCR Doc", "OCR Doc")
+	paragraph := docTree.Root.FirstChild
+	img := &ast.Node{Type: ast.NodeImage, ID: ast.NewNodeID(), Box: boxID, Path: docPath}
+	img.AppendChild(&ast.Node{Type: ast.NodeLinkDest, Tokens: []byte(key)})
+	paragraph.AppendChild(img)
+	if _, err := filesys.WriteTree(docTree); err != nil {
+		t.Fatalf("write encrypted doc failed: %v", err)
+	}
+	treenode.UpsertBlockTree(docTree)
+	sql.IndexTreeQueue(docTree)
+	sql.FlushQueue()
+	util.NodeOCRQueueLock.Lock()
+	pending := append([]string(nil), util.NodeOCRQueue...)
+	util.NodeOCRQueueLock.Unlock()
+	if !slices.Contains(pending, paragraph.ID) {
+		t.Fatalf("paragraph [%s] should be queued for OCR reindex, got %v", paragraph.ID, pending)
+	}
+	if _, _, matched, _, _ := FullTextSearchBlockInBoxWithHPathContext(context.Background(), "hello", nil, nil, nil, nil, 0, 1, 0, 1, 32, boxID, true, nil, nil); 0 != matched {
+		t.Fatalf("OCR text should not be searchable before reindex, matched=%d", matched)
+	}
+
+	// 3. 手动触发 OCR：解密 -> tesseract -> box 隔离文本
+	if _, err := OcrAssetInBox(boxID, relPath); err != nil {
+		t.Fatalf("ocr asset in box failed: %v", err)
+	}
+	ocrText := util.GetAssetText(key)
+	if !strings.Contains(strings.ToLower(ocrText), "hello") {
+		t.Fatalf("OCR text not found after recognition, got [%s]", ocrText)
+	}
+	if !util.ExistsAssetText(key) {
+		t.Fatal("box OCR text not recorded")
+	}
+	if util.ExistsAssetText(relPath) {
+		t.Fatal("box OCR text leaked into the global asset store")
+	}
+
+	// 4. 重索引挂起节点，OCR 文本应进入加密笔记本自己的 FTS
+	util.NodeOCRQueueLock.Lock()
+	pending = append([]string(nil), util.NodeOCRQueue...)
+	util.NodeOCRQueue = nil
+	util.NodeOCRQueueLock.Unlock()
+	for _, id := range pending {
+		sql.IndexNodeQueue(id)
+	}
+	sql.FlushQueue()
+	blocks, _, matched, _, _ := FullTextSearchBlockInBoxWithHPathContext(context.Background(), "hello", nil, nil, nil, nil, 0, 1, 0, 1, 32, boxID, true, nil, nil)
+	if matched < 1 {
+		t.Fatal("OCR text is not searchable inside the encrypted notebook")
+	}
+	searchHit := false
+	for _, b := range blocks {
+		if b.ID == paragraph.ID && strings.Contains(strings.ToLower(b.Content), "hello") {
+			searchHit = true
+		}
+	}
+	if !searchHit {
+		t.Fatal("the paragraph referencing the encrypted image was not returned by the in-box FTS search")
+	}
+
+	// 5. 全局（普通笔记本）搜索不得命中加密笔记本的 OCR 文本
+	if _, _, matched, _, _ := FullTextSearchBlockInBoxWithHPathContext(context.Background(), "hello", nil, nil, nil, nil, 0, 1, 0, 1, 32, "", true, nil, nil); 0 != matched {
+		t.Fatalf("OCR text leaked into the global search index, matched=%d", matched)
+	}
+
+	// 6. 明文 OCR 文本不得以明文出现在 sidecar
+	store, err := os.ReadFile(util.BoxAssetsTextsFilePath(boxID))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !IsEncryptedNotebookData(store) {
+		t.Fatal("box OCR texts sidecar is not encrypted at rest")
+	}
+	if bytes.Contains(store, []byte("hello")) || bytes.Contains(store, []byte(boxID)) {
+		t.Fatal("box OCR texts sidecar leaks plaintext or boxID")
+	}
+
+	// 7. 锁定：内存副本必须被丢弃
+	util.ClearBoxAssetsTexts(boxID)
+	if util.ExistsAssetText(key) {
+		t.Fatal("box OCR text survived the lock drop")
+	}
+
+	// 8. 重新解锁：从加密 sidecar 恢复
+	dek, ok := cachedDEKCopy(boxID)
+	if !ok {
+		t.Fatal("DEK not cached for the unlocked box")
+	}
+	defer zeroAndClear(dek)
+	if err := loadBoxOCRTexts(boxID, dek); err != nil {
+		t.Fatalf("load box OCR texts failed: %v", err)
+	}
+	if loaded := util.GetAssetText(key); loaded != ocrText {
+		t.Fatalf("restored OCR text mismatch: got [%s], want [%s]", loaded, ocrText)
+	}
+
+	// 9. 篡改的 sidecar 必须被拒绝
+	util.ClearBoxAssetsTexts(boxID)
+	if err := os.WriteFile(util.BoxAssetsTextsFilePath(boxID), []byte("tampered"), 0644); err != nil {
+		t.Fatal(err)
+	}
+	if err := loadBoxOCRTexts(boxID, dek); err == nil {
+		t.Fatal("tampered box OCR texts sidecar was not rejected")
+	}
+}
+
+// setupCryptoModelDirs points the util paths at a fresh temp root (shared by the other
+// encrypted-notebook sqlcipher tests).
+func setupCryptoModelDirs(t *testing.T) {
+	root := t.TempDir()
+	util.WorkspaceDir = root
+	util.DataDir = filepath.Join(root, "data")
+	util.TempDir = filepath.Join(root, "temp")
+	util.ConfDir = filepath.Join(root, "conf")
+	util.HistoryDir = filepath.Join(root, "history")
+	util.QueueDir = filepath.Join(util.TempDir, "queue")
+	util.DBPath = filepath.Join(util.TempDir, util.DBName)
+	util.HistoryDBPath = filepath.Join(util.TempDir, "history.db")
+	util.AssetContentDBPath = filepath.Join(util.TempDir, "asset_content.db")
+	util.BlockTreeDBPath = filepath.Join(util.TempDir, "blocktree.db")
+	for _, dir := range []string{util.DataDir, util.TempDir, util.ConfDir, util.HistoryDir} {
+		if err := os.MkdirAll(dir, 0755); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
